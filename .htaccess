Options -Indexes

<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType model/vnd.usdz+zip .usdz
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(glb|gltf|usdz)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>